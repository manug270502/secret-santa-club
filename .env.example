# Dominio pubblico del sito. Lascia vuoto su Netlify: viene rilevato automaticamente.
# Impostalo solo se vuoi forzare un dominio personalizzato.
PUBLIC_BASE_URL=

# In produzione la demo è disattivata per impostazione predefinita.
ENABLE_DEMO=false

# Regione europea per Netlify Blobs.
BLOBS_REGION=eu-central-1
