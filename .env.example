# Dominio pubblico del sito. Su Netlify normalmente resta vuoto.
PUBLIC_BASE_URL=

# In produzione la demo è disattivata per impostazione predefinita.
ENABLE_DEMO=false

# Regione europea usata dagli store Netlify Blobs esistenti.
BLOBS_REGION=eu-central-1

# Control Center super-admin. Non inserire mai la password in chiaro.
# 1) Scegli uno username.
SUPERADMIN_USERNAME=grande-elfo
# 2) Genera l'hash con: npm run superadmin:hash -- "LA-TUA-PASSWORD-LUNGA"
SUPERADMIN_PASSWORD_HASH=
# 3) Genera un segreto casuale di almeno 32 caratteri, ad esempio:
#    node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SUPERADMIN_SESSION_SECRET=
# Durata massima della sessione, da 1 a 24 ore.
SUPERADMIN_SESSION_HOURS=8
