# Non sono necessarie variabili per il primo deploy su Netlify.

# Lascia vuoto: il sito usa automaticamente il proprio dominio Netlify HTTPS.
PUBLIC_BASE_URL=

# In produzione la demo è disattivata per impostazione predefinita.
ENABLE_DEMO=false

# Facoltativo. Il progetto usa Francoforte per conservare i Blob nell'UE.
BLOBS_REGION=eu-central-1
