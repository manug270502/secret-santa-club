# Dominio pubblico del sito. Lascia vuoto su Netlify: viene rilevato automaticamente.
# Impostalo solo se vuoi forzare un dominio personalizzato.
PUBLIC_BASE_URL=

# In produzione la demo è disattivata per impostazione predefinita.
ENABLE_DEMO=false

# Regione europea per Netlify Blobs.
BLOBS_REGION=eu-central-1

# -----------------------------------------------------------------------------
# INVIO WHATSAPP AUTOMATICO CON TWILIO
# Questi valori devono essere aggiunti nelle Environment variables di Netlify.
# Non inserire credenziali reali in questo file e non commettere mai un file .env.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=

# Metodo consigliato: API Key + API Secret.
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Alternativa per test: Auth Token dell'account. Lascia vuoto se usi API Key.
TWILIO_AUTH_TOKEN=

# Metodo consigliato per il mittente: Messaging Service con il sender WhatsApp.
TWILIO_MESSAGING_SERVICE_SID=

# Alternativa al Messaging Service, per esempio whatsapp:+14155238886 nel Sandbox.
TWILIO_WHATSAPP_FROM=

# Content SID HX... del template WhatsApp. Variabili previste:
# {{1}} nome partecipante, {{2}} nome evento, {{3}} data, {{4}} link personale.
TWILIO_CONTENT_SID=

# SOLO per Sandbox o conversazioni già aperte nelle ultime 24 ore.
# In produzione lascia false e usa un Content SID approvato.
TWILIO_ALLOW_FREEFORM=false
